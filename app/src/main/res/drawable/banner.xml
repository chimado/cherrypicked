<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher banner: a cherry dot on the home screen's graphite gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape><gradient android:angle="270" android:startColor="#17181b" android:endColor="#0d0e10" /></shape>
    </item>
    <item android:gravity="center" android:width="56dp" android:height="56dp">
        <shape android:shape="oval"><solid android:color="#e0233f" /></shape>
    </item>
</layer-list>
